mutate(year=year(capture_date)) %>%
mutate(fasting = case_when(un_creat_ratio <= 10 ~ "not fasting",un_creat_ratio > 10 ~ "fasting"))
names(polar_bears)
polar_bears %>%
summarize(
min_UR = min(urea_nitrogen, na.rm = TRUE),
median_UR = median(urea_nitrogen, na.rm = TRUE),
mean_UR = mean(urea_nitrogen, na.rm = TRUE),
max_UR = max(urea_nitrogen, na.rm = TRUE),
min_CR = min(creatinine, na.rm = TRUE),
median_CR = median(creatinine, na.rm = TRUE),
mean_CR = mean(creatinine, na.rm = TRUE),
max_CR = max(creatinine, na.rm = TRUE),
.groups = "drop"
)
polar_bears %>%
summarize(
min_UR = min(urea_nitrogen, na.rm = TRUE),
median_UR = median(urea_nitrogen, na.rm = TRUE),
mean_UR = mean(urea_nitrogen, na.rm = TRUE),
max_UR = max(urea_nitrogen, na.rm = TRUE),
min_CR = min(creatinine, na.rm = TRUE),
median_CR = median(creatinine, na.rm = TRUE),
mean_CR = mean(creatinine, na.rm = TRUE),
max_CR = max(creatinine, na.rm = TRUE),
.groups = "drop"
)
un_creat_ratio <- polar_bears %>%
mutate(un_creat_ratio = (urea_nitrogen * 0.466) / creatinine)
un_creat_ratio
fasting10 <- un_creat_ratio %>%
mutate(fasting=case_when(un_creat_ratio<=10 ~ "not fasting",
un_creat_ratio>10 ~ "fasting")) %>%
select(popn, un_creat_ratio, fasting) %>%
mutate(fasting=factor(fasting,
levels=c("not fasting",
"fasting")))
fasting10
fasting_year <- un_creat_ratio %>%
mutate(year=year(capture_date)) %>%
mutate(fasting = case_when(un_creat_ratio <= 10 ~ "not fasting",un_creat_ratio > 10 ~ "fasting"))
fasting_counts <- fasting_year %>%
filter(fasting=="fasting") %>%
count(year,popn)
ggplot(fasting_counts,aes(x=year,y=n,color=popn)) +
geom_line() +
geom_point() +
labs(title="num of fasting polar bears by yr and popn",x="yr",y="num of fasting bears",color="popn")
polar_bears
ggplot(polar_bears, aes(x = long, y = lat, color = popn)) +
borders("world", colour = "blue", fill = "blue") +
geom_point(alpha = 0.7) +
coord_quickmap() +
labs(
title = "Locations of Polar Bears in the Study",
x = "Longitude",
y = "Latitude",
color = "Population"
)
