library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("7e1ebae2-6056-40c4-a2af-d1b197485428", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
summary(polar_bears)
names(polar_bears)
polar_bears
#NAs represented as unknown , in mating
# check how many NA values exist in each variable
polar_bears %>%
summarize(across(everything(), ~sum(is.na(.))))
# visualize missing data
gg_miss_var(polar_bears)
# sometimes datasets use alternative NA values like -999
polar_bears_clean <- polar_bears %>%
mutate(across(everything(), ~na_if(., -999)))
# check missing values
polar_bears %>%
summarize(across(everything(), ~sum(is.na(.))))
# visualize missing values
gg_miss_var(polar_bears)
# replace alternative NA values (-999) only in numeric columns
polar_bears_clean <- polar_bears %>%
mutate(across(where(is.numeric), ~na_if(., -999)))
# confirm replacement
polar_bears_clean %>%
summarize(across(everything(), ~sum(is.na(.))))
names(polar_bears)
polar_bears %>%
count(popn, sex)
polar_bears %>%
count(popn,sex) %>%
ggplot(aes(x=popn,y=n,fill=sex)) +
geom_col(position = "dodge") +
labs(title="num of polar bears sampled by sex and pop",x = "pop",y = "num of bears",fill = "sex")
names(polar_bears)
polar_bears
polar_bears_year<-polar_bears %>%
mutate(year=year(capture_date))
bears_by_year<-polar_bears_year %>%
count(year,popn)
ggplot(bears_by_year,aes(x=year,y=n,color=popn)) +
geom_line() +
geom_point() +
labs(title = "num of olar bears sampled each yr by pop",x = "yr",y = "num of Bears",color = "pop")
