library(tidyverse)
library(janitor)
library(ggmap)
library(leaflet)
register_stadiamaps("YOUR API KEY HERE", write = FALSE)
sharks <- read_csv("data/SharkIncidents_1950_2022_220302.csv") %>%
clean_names() %>%
filter(longitude !="NA" & latitude !="NA") %>% # pulling out NA locations
mutate(longitude = as.numeric(longitude)) # converting longitude to numeric
bbox
lat_range <- range(sharks$latitude, na.rm = TRUE)
long_range <- range(sharks$longitude, na.rm = TRUE)
bbox <- c(left = long_range[1] - 0.03*(long_range[2]-long_range[1]),
bottom = lat_range[1] - 0.03*(lat_range[2]-lat_range[1]),
right = long_range[2] + 0.03*(long_range[2]-long_range[1]),
top = lat_range[2] + 0.03*(lat_range[2]-lat_range[1]))
bbox
ggmap(base_map)
base_map <- get_stamenmap(bbox = bbox, zoom = 7, maptype = "terrain")
base_map <- get_stamenmap(bbox = bbox, zoom = 7, maptype = "terrain")
lat_range <- range(sharks$latitude, na.rm = TRUE)
long_range <- range(sharks$longitude, na.rm = TRUE)
bbox <- c(left = long_range[1] - 0.03*(long_range[2]-long_range[1]),
bottom = lat_range[1] - 0.03*(lat_range[2]-lat_range[1]),
right = long_range[2] + 0.03*(long_range[2]-long_range[1]),
top = lat_range[2] + 0.03*(lat_range[2]-lat_range[1]))
bbox
